# --- Base de datos ---
DATABASE_URL=postgres://usuario:password@localhost:5432/c010rnews
# Pon 1 si tu Postgres gestionado exige SSL sin CA verificable (Neon, Supabase, Railway...)
PGSSL=0

# --- Modelo que reescribe las noticias ---
# Vale cualquier proveedor con API compatible con OpenAI. Por defecto, Groq:
# gratis y sin tarjeta. La clave se saca en https://console.groq.com/keys
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
# Lista por orden de preferencia. Cada modelo tiene su propia bolsa diaria
# (Groq: 200.000 tokens/dia y 1000 peticiones/dia POR MODELO), asi que rotar
# entre varios multiplica lo que cabe en un dia. Cuando uno se agota, el
# cliente pasa al siguiente y lo apunta para no reintentarlo en cada tanda.
# El sufijo ":esfuerzo" es el reasoning_effort de cada modelo. Va por modelo
# porque no coinciden: los gpt-oss aceptan low/medium/high y los qwen solo
# none/default. Sin bajarlo, el modelo se gasta el cupo de salida razonando y
# devuelve el contenido vacio (json_validate_failed con failed_generation="").
LLM_MODEL=openai/gpt-oss-120b:low,openai/gpt-oss-20b:low,qwen/qwen3.8-27b:none,qwen/qwen3.6-27b:none

# Tokens por minuto que admite el proveedor. Es el limite que de verdad manda
# en las capas gratuitas, y el cliente se autorregula para no pasarse. Con el
# puesto no hacen falta reintentos por 429, que gastan peticion igual.
#   Groq gratis: 8000    ·    De pago o sin limite conocido: 0 (desactivado)
LLM_TOKENS_PER_MINUTE=8000
# Cuanto del articulo original ve el redactor. Con 6000 caracteres la peticion
# cabe en los 8000 tokens de Groq; con mas, las noticias largas dan 413.
LLM_MAX_SOURCE_CHARS=6000

# Los catalogos cambian cada pocos meses y un modelo retirado responde 404, asi
# que conviene listar los vivos antes de fijar uno. Ojo: la lista puede incluir
# modelos que tu clave no puede usar (dan 403), asi que prueba el elegido.
#   curl -s "$LLM_BASE_URL/models" -H "authorization: Bearer $LLM_API_KEY"
#
# Otros proveedores, con lo medido en cada uno:
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#               gemini-3.6-flash. Escribe muy bien, pero su capa gratuita da
#               20 peticiones AL DIA por modelo: no sostiene la ingesta.
#   OpenRouter  https://openrouter.ai/api/v1     deepseek/deepseek-chat-v3-0324:free
#   Cerebras    https://api.cerebras.ai/v1       llama-3.3-70b
#   DeepSeek    https://api.deepseek.com         deepseek-chat  (de pago)

# --- Sitio ---
SITE_NAME=c010r News
SITE_URL=http://localhost:3000
SITE_DESCRIPTION=Noticias de tecnologia, reescritas con criterio.

# --- Panel de administracion ---
ADMIN_PASSWORD=cambia-esto
AUTH_SECRET=genera-una-cadena-larga-aleatoria

# --- Cron de ingesta ---
CRON_SECRET=otro-secreto-largo
# Articulos nuevos como maximo por ejecucion del cron
INGEST_MAX_PER_RUN=6

# --- Control de publicacion ---
# 1 = el sistema publica solo; 0 = todo queda en borrador.
AUTO_PUBLISH=1
# Nota minima (0-100) para publicar sin revision humana.
# 0 = se publica todo lo que se reescriba correctamente, sin filtro de calidad.
AUTO_PUBLISH_MIN_SCORE=0
# Tope de articulos nuevos por fuente y tanda. Sin definir, se calcula como
# una cuarta parte de INGEST_MAX_PER_RUN (minimo 2), para que la portada no
# la copen uno o dos medios.
# INGEST_MAX_PER_SOURCE=3

# Opcional: token de GitHub para el descubrimiento de repositorios en alza.
# Sin el son 60 peticiones por hora; con el, 5000. No necesita ningun permiso.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Product Hunt. Su RSS publico no trae descripciones y el sitio bloquea las
# peticiones de servidor, asi que esa fuente va por la API oficial.
#
# En https://www.producthunt.com/v2/oauth/applications se REGISTRA UNA
# APLICACION (es gratis) y se obtienen dos credenciales. Con ellas el sistema
# pide un token solo, y lo renueva cuando caduca:
# PRODUCTHUNT_CLIENT_ID=
# PRODUCTHUNT_CLIENT_SECRET=
#
# Alternativa: esa misma pantalla ofrece un "Developer Token" ya generado.
# Si lo pones aqui, se usa ese y las dos variables de arriba sobran.
# PRODUCTHUNT_TOKEN=

# Antiguedad maxima de una noticia para entrar. Mas vieja, se ignora: un feed
# puede arrastrar entradas de hace semanas y no son novedad.
INGEST_MAX_AGE_HOURS=24
