[Unit]
Description=Ingesta de noticias de c010r News
After=bookingly.service

[Service]
Type=oneshot
User=bookingly
Group=bookingly
WorkingDirectory=/opt/bookingly.cloud
EnvironmentFile=/opt/bookingly.cloud/.env
# tsx directamente con node: npm necesita escribir en $HOME y aqui no hay.
Environment=HOME=/opt/bookingly.cloud
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs scripts/ingest.ts
# Systemd no lanza una segunda instancia mientras la anterior sigue viva, asi
# que el timeout debe caber dentro del intervalo de 5 min: una ejecucion
# atascada solo se come su turno, no los siguientes.
TimeoutStartSec=270
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bookingly-ingest
