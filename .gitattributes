# El repositorio se despliega en Linux desde una maquina Windows: si los scripts
# de shell o las unidades de systemd viajaran con CRLF, el servidor fallaria con
# un "bad interpreter: /usr/bin/env bash^M". Forzamos LF en todo el texto.
* text=auto eol=lf

*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
